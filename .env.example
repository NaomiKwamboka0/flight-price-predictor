# ==================== FLIGHT APIs ====================
# Get free keys from these services:

# Skyscanner API (via RapidAPI)
# Sign up: https://rapidapi.com/ → Search "Skyscanner"
VITE_SKYSCANNER_API_KEY=your_skyscanner_api_key_here
VITE_SKYSCANNER_API_HOST=skyscanner44.p.rapidapi.com

# Amadeus API (Official, free tier)
# Sign up: https://developers.amadeus.com/
VITE_AMADEUS_API_KEY=your_amadeus_api_key_here
VITE_AMADEUS_API_SECRET=your_amadeus_api_secret_here

# Kiwi.com API (Free tier available)
# Sign up: https://tequila.kiwi.com/
VITE_KIWI_API_KEY=your_kiwi_api_key_here

# Kayak API (via RapidAPI)
# Sign up: https://rapidapi.com/ → Search "Kayak"
VITE_KAYAK_API_KEY=your_kayak_api_key_here

# Google Flights (via SerpAPI)
# Sign up: https://serpapi.com/
VITE_SERPAPI_KEY=your_serpapi_key_here

# Aviasales API
# Sign up: https://aviasales.com/developer/
VITE_AVIASALES_MARKER=your_aviasales_marker_here

# ==================== WEATHER API ====================
# OpenWeatherMap API
# Sign up: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Weather.com API (Optional alternative)
VITE_WEATHER_API_KEY=your_weather_api_key_here

# ==================== AI CHATBOT APIs ====================
# Hugging Face API (LLaMA, Mistral, etc.)
# Sign up: https://huggingface.co/
VITE_HUGGING_FACE_API_KEY=your_hugging_face_api_key_here

# OpenAI API (Alternative, has free credits)
# Sign up: https://platform.openai.com/
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Cohere API (Alternative AI)
# Sign up: https://cohere.com/
VITE_COHERE_API_KEY=your_cohere_api_key_here

# ==================== TRAVEL & SAFETY APIs ====================
# SafetyWing TravelPass API
VITE_SAFETYWING_API_KEY=your_safetywing_api_key_here

# Trivago API (for hotel data)
VITE_TRIVAGO_API_KEY=your_trivago_api_key_here

# CDC Travel Health Notices (public - no key needed)
VITE_CDC_TRAVEL_API=https://www.cdc.gov/covid-data-tracker/

# ==================== CLOUD & DATABASE ====================
# Firebase Config (for storing user data, price history)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Supabase (Alternative to Firebase)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ==================== CURRENCY & CONVERSION ====================
# Exchange rates API
VITE_EXCHANGE_API_KEY=your_exchange_api_key_here

# ==================== APP SETTINGS ====================
# Environment
VITE_ENV=development

# Enable/disable features
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_PRICE_PREDICTION=true
VITE_ENABLE_WEATHER=true
VITE_ENABLE_SAFETY_ALERTS=true

# API preferences (which APIs to try first)
VITE_PREFERRED_FLIGHT_API=skyscanner
VITE_FALLBACK_FLIGHT_APIS=amadeus,kiwi,kayak

# Rate limiting
VITE_REQUESTS_PER_MINUTE=30
VITE_CACHE_DURATION_MINUTES=60

# Debug mode
VITE_DEBUG=false
