# ==================== FLIGHT PRICE PREDICTOR - API KEYS ====================
# Copy this file to .env and fill in your API keys
# NEVER commit the .env file - it contains sensitive credentials!
# Add .env to .gitignore

# ==================== FLIGHT SEARCH APIs ====================
# Choose at least one. The app will use them in priority order.

# 1. SKYSCANNER (via RapidAPI) - Most reliable for worldwide flights
# Get free key: https://rapidapi.com/asapAPIv2/api/skyscanner44
# Free tier: 100 requests/month
VITE_SKYSCANNER_API_KEY=your_skyscanner_rapidapi_key_here
VITE_SKYSCANNER_API_HOST=skyscanner44.p.rapidapi.com

# 2. AMADEUS - Professional flight data API
# Get free key: https://developers.amadeus.com/
# Free tier: 2000 API calls/month
VITE_AMADEUS_API_KEY=your_amadeus_client_id_here
VITE_AMADEUS_API_SECRET=your_amadeus_client_secret_here

# 3. KIWI.COM - Budget flights specialist
# Get free key: https://tequila.kiwi.com/
# Free tier: unlimited (with rate limits)
VITE_KIWI_API_KEY=your_kiwi_api_key_here

# 4. KAYAK (via RapidAPI) - Meta-search engine
# Get free key: https://rapidapi.com/asapAPIv2/api/kayak
# Free tier: 100 requests/month
VITE_KAYAK_API_KEY=your_kayak_rapidapi_key_here

# 5. SERPAPI (Google Flights) - Unofficial Google Flights API
# Get free key: https://serpapi.com/
# Free tier: 100 searches/month
VITE_SERPAPI_KEY=your_serpapi_key_here

# ==================== WEATHER API ====================
# Optional: Weather information for destinations
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# ==================== AI/CHATBOT APIs ====================
VITE_HUGGING_FACE_API_KEY=your_huggingface_token_here
VITE_OPENAI_API_KEY=your_openai_api_key_here

# ==================== FIREBASE ====================
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
FIREBASE_APP_ID=your_firebase_app_id_here
